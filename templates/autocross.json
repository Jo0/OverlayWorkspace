{
  "schema": "overlay-template/1",
  "id": "autocross",
  "name": "Autocross",
  "sessionType": "autocross",
  "description": "One run per lap. The run timer holds the final time after the finish; delta against your best (clean) run; course map of the current run.",
  "canvas": { "width": 3840, "height": 2160 },
  "theme": "default",
  "timing": { "comparison": "best" },
  "elements": [
    { "id": "timer", "type": "laptimer", "name": "Run timer", "x": 110, "y": 100, "w": 1100, "h": 430, "anchor": "tl",
      "props": { "title": "RUN {lap}", "showLast": true, "showBest": true, "lastLabel": "LAST", "bestLabel": "BEST" } },
    { "id": "delta", "type": "delta", "name": "Delta", "x": 1320, "y": 100, "w": 1200, "h": 260, "anchor": "tc",
      "props": { "label": "Δ BEST", "decimals": 2, "range": 2 } },
    { "id": "map", "type": "trackmap", "name": "Course map", "x": 2880, "y": 90, "w": 860, "h": 860, "anchor": "tr",
      "props": { "scope": "lap", "lineWidth": 12, "dotSize": 24 } },
    { "id": "speed", "type": "readout", "name": "Speed", "x": 110, "y": 1700, "w": 560, "h": 360, "anchor": "bl",
      "props": { "channel": "@speed", "unit": "mph", "decimals": 0, "digits": 3, "label": "MPH" } },
    { "id": "throttle", "type": "bar", "name": "Throttle", "x": 710, "y": 1700, "w": 110, "h": 360, "anchor": "bl",
      "props": { "channel": "@throttle", "min": 0, "max": 100, "label": "THR", "fill": "good" } },
    { "id": "brake", "type": "bar", "name": "Brake", "x": 850, "y": 1700, "w": 110, "h": 360, "anchor": "bl",
      "props": { "channel": "@brake", "min": 0, "max": 100, "label": "BRK", "fill": "bad" } },
    { "id": "g", "type": "gcircle", "name": "G-force", "x": 3240, "y": 1460, "w": 500, "h": 500, "anchor": "br",
      "props": { "max": 1.5, "rings": 3, "trail": 1 } }
  ]
}
