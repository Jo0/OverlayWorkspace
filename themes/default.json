{
  "schema": "overlay-theme/1",
  "id": "default",
  "name": "Default (dark glass)",
  "colors": {
    "text": "#FFFFFF",
    "muted": "rgba(255,255,255,0.62)",
    "panel": "rgba(8,10,14,0.58)",
    "border": "rgba(255,255,255,0.14)",
    "accent": "#FFB000",
    "good": "#2ED47A",
    "bad": "#FF4D4D",
    "track": "rgba(255,255,255,0.42)",
    "marker": "#FFB000",
    "grid": "rgba(255,255,255,0.16)"
  },
  "fonts": {
    "display": { "family": "'Segoe UI', system-ui, Roboto, sans-serif", "weight": 700 },
    "number": { "family": "'Segoe UI', system-ui, Roboto, sans-serif", "weight": 700, "tabular": true },
    "label": { "family": "'Segoe UI', system-ui, Roboto, sans-serif", "weight": 600, "letterSpacing": 0.08 }
